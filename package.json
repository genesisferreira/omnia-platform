{
  "name": "omnia-platform",
  "version": "0.3.0",
  "private": true,
  "description": "Plataforma SaaS modular do ecossistema Omnia Frigo Holding",
  "license": "MIT",
  "author": "Omnia Frigo Holding",
  "packageManager": "pnpm@9.15.0",
  "prettier": "@omnia/prettier-config",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@omnia/web --filter=@omnia/admin",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "docker:dev": "docker compose -f docker/compose/development.yml --env-file .env up -d",
    "docker:down": "docker compose -f docker/compose/development.yml --env-file .env down",
    "docker:logs": "docker compose -f docker/compose/development.yml --env-file .env logs -f",
    "docker:staging:config": "docker compose -f docker/compose/staging.yml --env-file .env.staging.example config",
    "docker:staging:build": "docker compose -f docker/compose/staging.yml --env-file .env.staging build",
    "docker:staging:migrate": "docker compose -f docker/compose/staging.yml --env-file .env.staging --profile bootstrap run --rm admin-migrate",
    "docker:staging:seed": "docker compose -f docker/compose/staging.yml --env-file .env.staging --profile bootstrap run --rm admin-seed",
    "docker:staging:bootstrap": "docker compose -f docker/compose/staging.yml --env-file .env.staging --profile bootstrap run --rm admin-bootstrap",
    "docker:staging:up": "docker compose -f docker/compose/staging.yml --env-file .env.staging up -d --build",
    "docker:staging:down": "docker compose -f docker/compose/staging.yml --env-file .env.staging down"
  },
  "devDependencies": {
    "@omnia/eslint-config": "workspace:*",
    "@omnia/prettier-config": "workspace:*",
    "@omnia/typescript-config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
