# =============================================================================
# Omnia Platform — Variáveis de Ambiente
# Copie para .env e ajuste conforme necessário
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=omnia
POSTGRES_PASSWORD=omnia_dev_password
POSTGRES_DB=omnia_platform
DATABASE_URL=postgresql://omnia:omnia_dev_password@localhost:5432/omnia_platform

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# MinIO (Object Storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=omnia_minio
MINIO_SECRET_KEY=omnia_minio_secret
MINIO_BUCKET=omnia-media
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# n8n (Automações)
# -----------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678

# -----------------------------------------------------------------------------
# Payload CMS (somente apps/admin)
# -----------------------------------------------------------------------------
PAYLOAD_SECRET=change-me-to-a-secure-random-string-min-32-chars

# -----------------------------------------------------------------------------
# Internal API (Portal → Admin, server-to-server)
# -----------------------------------------------------------------------------
# Segredo server-only para comunicação interna apps/web → apps/admin.
# Mínimo recomendado: 32 caracteres (valor aleatório forte).
# Usado apenas na comunicação Portal → Admin.
# Nunca expor no browser. Nunca prefixar com NEXT_PUBLIC_.
# Nunca reutilizar PAYLOAD_SECRET.
OMNIA_INTERNAL_API_SECRET=

# -----------------------------------------------------------------------------
# AI Providers (Sprint 8+)
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Authentication (Sprint 2+)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-secure-jwt-secret-min-32-chars

# -----------------------------------------------------------------------------
# pgAdmin
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@omnia.local
PGADMIN_DEFAULT_PASSWORD=omnia_pgadmin

# -----------------------------------------------------------------------------
# SMTP (Mailpit em DEV; Titan/HostGator em staging/prod)
# -----------------------------------------------------------------------------
# DEV (Mailpit): host local sem autenticação.
# Titan: SMTP_HOST=smtp.titan.email SMTP_PORT=587 SMTP_SECURE=false
#        + SMTP_USER + SMTP_PASS (nunca versionar a senha).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@omnia.local
MAILPIT_WEB_URL=http://localhost:8025

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_VERSION=0.3.0
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NODE_ENV=development
