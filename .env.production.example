# =============================================================================
# Omnia Platform — Produção (VPS)
# Copie para .env.production no servidor e substitua TODOS os placeholders.
#
# NUNCA commitar .env.production.
# Permissão recomendada no servidor: chmod 600 .env.production
#
# Domínios:
#   Portal: https://omniafrigo.com.br (www redireciona para apex)
#   Admin:  https://admin.omniafrigo.com.br
# =============================================================================

####################
# APP
####################

NODE_ENV=production
APP_VERSION=1.0.0
COMPOSE_PROJECT_NAME=omnia-platform-prod
DOCKER_BUILDKIT=1

####################
# NEXT (públicas — usadas no build das imagens)
####################

NEXT_PUBLIC_APP_URL=https://omniafrigo.com.br
NEXT_PUBLIC_ADMIN_URL=https://admin.omniafrigo.com.br

####################
# DATABASE (PostgreSQL isolado de produção)
####################

POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=omnia_platform_prod

# Host = nome do serviço Compose na rede omnia_prod_internal
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/omnia_platform_prod

####################
# REDIS (isolado de produção)
####################

REDIS_URL=redis://redis:6379

####################
# PAYLOAD
####################

# Segredo do Payload CMS — mínimo 32 caracteres, valor aleatório forte.
# Nunca reutilizar o valor de staging.
PAYLOAD_SECRET=<PAYLOAD_SECRET_MIN_32_CHARS>

####################
# INTERNAL API (Portal → Admin)
####################

# Segredo server-only. Mínimo 32 caracteres.
# Idêntico no Web e no Admin. Nunca prefixar com NEXT_PUBLIC_.
# Nunca reutilizar PAYLOAD_SECRET nem o valor de staging.
OMNIA_INTERNAL_API_SECRET=<OMNIA_INTERNAL_API_SECRET_MIN_32_CHARS>

####################
# TRAEFIK
####################

TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

####################
# SMTP
####################

# Ausente nesta Release 1.0 — o Payload não possui adapter de e-mail configurado.
# Não preencher; reset de senha por e-mail não está disponível.
