# =============================================================================
# Omnia Platform — Homologação (VPS)
# Copie para .env.staging no servidor e substitua TODOS os placeholders.
#
# IMPORTANTE:
# Os hosts abaixo DEVEM corresponder aos nomes reais dos containers/serviços
# já existentes na rede Docker omnia_internal do VPS.
# Não assuma nomes como postgres, redis ou minio — confirme com:
#   docker network inspect omnia_internal
# =============================================================================

####################
# APP
####################

NODE_ENV=staging
APP_VERSION=0.3.0
COMPOSE_PROJECT_NAME=omnia-platform-dev
DOCKER_BUILDKIT=1

####################
# NEXT
####################

# Domínios públicos expostos via Traefik (HTTPS)
NEXT_PUBLIC_APP_URL=https://dev.omniafrigo.com.br
NEXT_PUBLIC_ADMIN_URL=https://admin.dev.omniafrigo.com.br

####################
# DATABASE
####################

# Nome do serviço/container PostgreSQL na rede omnia_internal
POSTGRES_HOST=<NOME_DO_SERVICO_POSTGRES>
POSTGRES_PORT=5432
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=<POSTGRES_DATABASE>

# Montar a URL com os valores reais do VPS
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<NOME_DO_SERVICO_POSTGRES>:5432/<POSTGRES_DATABASE>

####################
# REDIS
####################

# Nome do serviço/container Redis na rede omnia_internal
REDIS_HOST=<NOME_DO_SERVICO_REDIS>
REDIS_PORT=6379
REDIS_URL=redis://<NOME_DO_SERVICO_REDIS>:6379

####################
# MINIO
####################

# Nome do serviço/container MinIO na rede omnia_internal
MINIO_HOST=<NOME_DO_SERVICO_MINIO>
MINIO_PORT=9000
MINIO_ACCESS_KEY=<MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<MINIO_SECRET_KEY>
MINIO_BUCKET=<MINIO_BUCKET>
MINIO_USE_SSL=false

####################
# PAYLOAD
####################

# Segredo do Payload CMS — mínimo 32 caracteres, valor aleatório forte
PAYLOAD_SECRET=<PAYLOAD_SECRET_MIN_32_CHARS>

####################
# TRAEFIK
####################

# Ajuste conforme configuração real do Traefik no VPS
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

####################
# N8N
####################

# Serviço existente no VPS — referência para integrações futuras
N8N_HOST=<NOME_DO_SERVICO_N8N>
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://<NOME_DO_SERVICO_N8N_PUBLICO>

####################
# DEEPSEEK
####################

# Provider de IA — Sprint futura
DEEPSEEK_API_KEY=

####################
# OPENAI
####################

# Provider de IA — Sprint futura
OPENAI_API_KEY=
