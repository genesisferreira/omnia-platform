{
  "extends": "@omnia/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@payload-config": ["./payload.config.ts"]
    },
    "plugins": [{ "name": "next" }],
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // CLI seeds/scripts are not Next runtime; typecheck them via `pnpm typecheck:cli`.
  "exclude": ["node_modules", "src/scripts", "src/seed"]
}
