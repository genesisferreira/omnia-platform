# Configuração do ops/backup/omnia-backup.sh — copie para fora do repositório e ajuste.
# Nunca coloque senhas aqui: o dump usa o usuário do próprio container do Postgres.

# Rótulo do ambiente (vira subdiretório em BACKUP_ROOT).
BACKUP_LABEL=dev

# Container do PostgreSQL e banco (vazio = POSTGRES_DB do container).
PG_CONTAINER=nome-do-container-postgres
PG_DATABASE=

# Volumes Docker de mídia, separados por espaço (acadêmica + Marketplace ficam no mesmo volume do admin).
MEDIA_VOLUMES="nome_do_volume_de_midia"

# Destino local. Deve ficar em disco/partição que não seja a mesma do banco quando possível,
# e ser sincronizado para um destino externo (ver docs/ops/BACKUP_AND_RECOVERY.md).
BACKUP_ROOT=/var/backups/omnia

# Retenção: remove backups com mais de RETENTION_DAYS dias, mas mantém sempre os RETENTION_MIN_KEEP mais recentes.
RETENTION_DAYS=14
RETENTION_MIN_KEEP=7

# Espaço mínimo livre (GB) e fator sobre o tamanho estimado (banco + mídia).
MIN_FREE_GB=5
FREE_SPACE_FACTOR=3

# Criptografia: none | gpg. Com gpg, use a chave PÚBLICA; a privada fica fora do servidor.
ENCRYPT=none
GPG_RECIPIENT=

# Arquivos de configuração sem segredos para guardar junto (ex.: compose e override de imagens).
EXTRA_FILES=""
# Arquivos .env dos quais só os NOMES das variáveis são registrados.
ENV_FILES_KEYS_ONLY=""
# Containers cujo nome/imagem/ID ficam registrados no backup.
RECORD_CONTAINERS=""

# Comando opcional de alerta (recebe OMNIA_BACKUP_STATUS, OMNIA_BACKUP_LABEL). Ex.: webhook interno.
ALERT_COMMAND=""
ALERT_ON_SUCCESS=0
