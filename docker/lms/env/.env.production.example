# Omnia LMS PRODUCTION — prepared only (do NOT deploy in this sprint)
# Copy to .env.production on VPS when ready; chmod 600; distinct secrets from DEV.

OMNIA_LMS_ENV=production
COMPOSE_PROJECT_NAME=omnia-lms-prod

MOODLE_WWWROOT=https://moodle.omniafrigo.com.br
MOODLE_DATAROOT=/var/www/moodledata
MOODLE_SALT=CHANGE_ME_prod_salt_min_32_chars_xxxxxxxxxxxx
MOODLE_AUTO_INSTALL=0
MOODLE_SITE_FULLNAME=Omnia LMS Engine
MOODLE_SITE_SHORTNAME=OmniaLMS
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=CHANGE_ME_prod_admin_password
MOODLE_ADMIN_EMAIL=platform@omniafrigo.com.br
MOODLE_IMAGE_TAG=2.4.1
MOODLE_CRON_INTERVAL_SECONDS=60

MOODLE_DB_HOST=mariadb
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=CHANGE_ME_prod_db_password
MOODLE_DB_PREFIX=mdl_
MOODLE_DB_ROOT_PASSWORD=CHANGE_ME_prod_root_password

MOODLE_REDIS_HOST=redis
MOODLE_REDIS_PORT=6379
MOODLE_REDIS_SESSION_DB=0
MOODLE_REDIS_CACHE_DB=1
MOODLE_REDIS_PREFIX=omnia_lms_prod_

MOODLE_SMTP_HOST=smtp.titan.email
MOODLE_SMTP_PORT=587
MOODLE_SMTP_SECURE=tls
MOODLE_SMTP_USER=
MOODLE_SMTP_PASS=
MOODLE_SMTP_FROM=noreply@omniafrigo.com.br

TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
MOODLE_HOSTNAME=moodle.omniafrigo.com.br
