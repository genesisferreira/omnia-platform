# Omnia LMS — shared variable reference (copy to .env.dev / .env.production)
# NEVER commit real secrets.

# --- Project ---
OMNIA_LMS_ENV=dev
COMPOSE_PROJECT_NAME=omnia-lms-dev

# --- Moodle ---
MOODLE_WWWROOT=https://moodle.dev.omniafrigo.com.br
MOODLE_DATAROOT=/var/www/moodledata
MOODLE_SALT=CHANGE_ME_long_random_salt
MOODLE_AUTO_INSTALL=1
MOODLE_SITE_FULLNAME=Omnia LMS Engine DEV
MOODLE_SITE_SHORTNAME=OmniaLMS
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=CHANGE_ME_strong_admin_password
MOODLE_ADMIN_EMAIL=platform@omniafrigo.com.br
MOODLE_IMAGE_TAG=2.4.1
MOODLE_CRON_INTERVAL_SECONDS=60

# --- MariaDB ---
MOODLE_DB_HOST=mariadb
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=CHANGE_ME_strong_db_password
MOODLE_DB_PREFIX=mdl_
MOODLE_DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password

# --- Redis ---
MOODLE_REDIS_HOST=redis
MOODLE_REDIS_PORT=6379
MOODLE_REDIS_SESSION_DB=0
MOODLE_REDIS_CACHE_DB=1
MOODLE_REDIS_PREFIX=omnia_lms_dev_

# --- SMTP (corporate; no fake) ---
MOODLE_SMTP_HOST=smtp.titan.email
MOODLE_SMTP_PORT=587
MOODLE_SMTP_SECURE=tls
MOODLE_SMTP_USER=
MOODLE_SMTP_PASS=
MOODLE_SMTP_FROM=noreply@omniafrigo.com.br

# --- Traefik ---
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
MOODLE_HOSTNAME=moodle.dev.omniafrigo.com.br

# --- Web Services (Connector Omnia — token NÃO fica neste arquivo em runtime) ---
# Ver docs/lms/OMNIA_LMS_MOODLE_SERVICE_SETUP.md
# Token vai para secrets do Admin/Platform (MOODLE_REST_TOKEN), nunca para o browser.
MOODLE_WS_SERVICE_NAME=omnia_lms_readonly
MOODLE_WS_TECHNICAL_USER=omnia_ws_readonly
