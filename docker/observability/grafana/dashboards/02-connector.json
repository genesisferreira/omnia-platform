{
  "uid": "omnia-lms-connector",
  "title": "Omnia LMS — Connector",
  "tags": ["omnia", "lms", "connector"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum by (route) (rate(http_requests_total[5m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP latency P95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache hit / miss",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(connector_cache_hit_total[5m]))", "legendFormat": "hit" },
        { "expr": "sum(rate(connector_cache_miss_total[5m]))", "legendFormat": "miss" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Moodle requests / errors",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(moodle_requests_total[5m]))", "legendFormat": "requests" },
        { "expr": "sum(rate(moodle_errors_total[5m]))", "legendFormat": "errors" }
      ]
    }
  ]
}
