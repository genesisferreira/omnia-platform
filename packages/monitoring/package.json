{
  "name": "@omnia/monitoring",
  "version": "0.0.0",
  "private": true,
  "description": "Observabilidade — health, metrics, tracing, alerts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./health": "./src/health/index.ts",
    "./metrics": "./src/metrics/index.ts",
    "./tracing": "./src/tracing/index.ts",
    "./alerts": "./src/alerts/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/metrics/test-prometheus.ts src/tracing/test-tracing.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@omnia/database": "workspace:*"
  },
  "devDependencies": {
    "@omnia/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
